<!--
    MainWindow.xaml
    XAML describes the visual tree of the WPF user interface.

    The window intentionally contains almost no application logic. It binds
    controls to MainViewModel properties and commands.

    Main sections:
      1. Server status
      2. Server settings
      3. Manual server controls
      4. Player access control
      5. Advanced settings
      6. Embedded server console
      7. BCS Tool console
      8. Manual command input
      9. Status/footer
-->
<Window x:Class="BCSTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BCSTool.Models"
        Title="BCS Tool"
        Width="1180"
        Height="820"
        MinWidth="1000"
        MinHeight="700"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Window.Resources>
        <!--
            Buttons use their layout cell's available width rather than
            hard-coded widths. MinHeight + padding keeps them comfortable at
            both the minimum window size and larger resolutions.
        -->
        <Style TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220" MinHeight="205"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            STATUS AREA
            Displays values supplied by MainViewModel:
            server lifecycle state, uptime, and next restart.
        -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server state" FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,0"
                                VerticalAlignment="Center">

                        <!--
                            Colored lifecycle indicator.

                            Grey   = offline/stopped
                            Yellow = starting/transitional state
                            Green  = online/ready
                            Red    = crashed/error
                        -->
                        <Ellipse Width="13"
                                 Height="13"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <!-- Default/offline color -->
                                    <Setter Property="Fill"
                                            Value="{DynamicResource MutedForegroundBrush}"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.Ready}">
                                            <Setter Property="Fill" Value="LimeGreen"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.Starting}">
                                            <Setter Property="Fill" Value="Gold"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.WaitingForReady}">
                                            <Setter Property="Fill" Value="Gold"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.Saving}">
                                            <Setter Property="Fill" Value="Gold"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.Stopping}">
                                            <Setter Property="Fill" Value="Gold"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.Restarting}">
                                            <Setter Property="Fill" Value="Gold"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.Crashed}">
                                            <Setter Property="Fill" Value="Red"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.Error}">
                                            <Setter Property="Fill" Value="Red"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ServerState}"
                                                     Value="{x:Static models:ServerState.PortBlocked}">
                                            <Setter Property="Fill" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding ServerStateText}"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
<StackPanel Grid.Column="1">
                    <TextBlock Text="Uptime" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding UptimeText}"
                               FontSize="18"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Next restart" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding NextRestartText}"
                               FontSize="18"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            SETTINGS + CONTROLS
            Four parallel sections:
              1. Server Settings
              2. Server Controls
              3. Access Control (Beta)
              4. Advanced Settings
        -->
        <Grid Grid.Row="1"
              Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" MinWidth="245"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.1*" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="0.75*" MinWidth="185"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.2*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Server executable + configuration editors -->
            <GroupBox Grid.Column="0"
                      Header="Server Settings">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Server executable:"
                               Margin="0,0,0,4"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding ServerExecutableDisplay, Mode=OneWay}"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,6,0"/>

                        <Button Grid.Column="1"
                                Content="Browse..."
                                Command="{Binding BrowseServerCommand}"/>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding ServerExecutableDetectionStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                    <Grid Grid.Row="3"
                          Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Server Configuration"
                                Click="ServerConfiguration_Click"
                                Margin="0,0,4,0"/>

                        <Button Grid.Column="1"
                                Content="Mod Configuration"
                                Click="ModConfiguration_Click"
                                Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          Margin="5,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Scheduled automation launchers -->
            <GroupBox Grid.Column="6"
                      Header="Advanced Settings">
                <Grid Margin="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Restart Schedule"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RestartScheduleSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,5"/>
                        <Button Content="Restart Schedule..."
                                Click="RestartSchedule_Click"/>
                    </StackPanel>

                    <Separator Grid.Row="1"
                               Margin="0,7"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Scheduled Broadcasts"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ScheduledBroadcastsSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,5"/>
                        <Button Content="Scheduled Broadcasts..."
                                Click="ScheduledBroadcasts_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          Margin="5,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Manual server controls -->
            <GroupBox Grid.Column="2"
                      Header="Server Controls">
                <UniformGrid Rows="2"
                             Columns="3"
                             Margin="10">
                    <Button Content="Start"
                            Command="{Binding StartCommand}"
                            Margin="4"/>

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Margin="4"/>

                    <Button Content="Restart"
                            Command="{Binding RestartCommand}"
                            Margin="4"/>

                    <Button Content="Stop"
                            Command="{Binding StopCommand}"
                            Margin="4"/>

                    <Button Content="Clear BCS Tool Console"
                            Command="{Binding ClearConsoleCommand}"
                            Margin="4"/>

                    <Button Content="Open Server Logs"
                            Command="{Binding OpenServerLogsCommand}"
                            Margin="4"/>
                </UniformGrid>
            </GroupBox>

            <GridSplitter Grid.Column="5"
                          Width="6"
                          Margin="5,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Player access policy and SteamID64 lists -->
            <GroupBox Grid.Column="4"
                      Header="Access Control (Beta)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Access mode:"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="PlayerAccessModeComboBox"
                              Grid.Row="1"
                              ItemsSource="{Binding PlayerAccessModeOptions}"
                              SelectedItem="{Binding PlayerAccessMode, Mode=OneWay}"
                              SelectionChanged="PlayerAccessMode_SelectionChanged"
                              VerticalContentAlignment="Center"
                              Margin="0,3,0,7"/>

                    <Button Grid.Row="2"
                            Content="Banlist/Whitelist Panel"
                            Click="PlayerAccess_Click"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"/>

                    <Button Grid.Row="3"
                            Content="Player List"
                            Click="KnownPlayers_Click"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="4"
                               Margin="0,7,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Text="Banlist: blocks listed SteamID64s.&#10;Whitelist: allows only listed SteamID64s."/>
                </Grid>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      Margin="0,5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"/>


        <!--
            CONSOLE AREA

            Server Console
                Live output from the active coop-server-*.log. Structured @DS@
                records are consumed internally rather than shown as giant JSON
                lines. The Players pane is built from @DS@ player snapshots.

            BCS Tool Console
                Scheduling, restart, save, recovery, and diagnostic messages.

            Command input is a normal local WPF editor. Tab autocomplete and
            history are handled locally; the complete line is sent on Enter.
        -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*" MinWidth="290"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                          Header="Server Console">
                    <Grid Margin="8">
                        <ListBox x:Name="ServerConsoleList"
                                 ItemsSource="{Binding ServerConsoleLines}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="{DynamicResource ConsoleBackgroundBrush}"
                                 Foreground="{DynamicResource ConsoleForegroundBrush}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding Foreground}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              Margin="6,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <GroupBox Grid.Column="2"
                          Header="{Binding PlayersHeaderText}">
                    <ListBox x:Name="PlayerInformationList"
                             ItemsSource="{Binding PlayerLines}"
                             Margin="8"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="{DynamicResource ConsoleBackgroundBrush}"
                             Foreground="{DynamicResource ConsoleForegroundBrush}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseRightButtonDown="PlayerInformation_PreviewMouseRightButtonDown"
                             ContextMenuOpening="PlayerInformation_ContextMenuOpening">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="KickPlayerMenuItem"
                                          Header="Kick"
                                          Click="KickPlayer_Click"/>
                                <MenuItem x:Name="BanPlayerMenuItem"
                                          Header="Ban"
                                          Click="BanPlayer_Click"/>
                                <MenuItem x:Name="CopyPlayerSteamIdMenuItem"
                                          Header="Copy SteamID"
                                          Click="CopyPlayerSteamId_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          Margin="0,4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

            <GroupBox Grid.Row="2"
                      Header="BCS Tool Console"
                      Margin="0,0,0,8">
                <Grid Margin="8">
                    <ListBox x:Name="BcsToolConsoleList"
                             ItemsSource="{Binding ConsoleLines}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="{DynamicResource ConsoleBackgroundBrush}"
                             Foreground="{DynamicResource ConsoleForegroundBrush}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{Binding Foreground}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="CommandInput"
                         Grid.Column="0"
                         Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="CommandInput_PreviewKeyDown"
                         TextChanged="CommandInput_TextChanged"
                         LostKeyboardFocus="CommandInput_LostKeyboardFocus"
                         FontFamily="Consolas"
                         MinHeight="30"
                         VerticalContentAlignment="Center"
                         SpellCheck.IsEnabled="False"
                         Margin="0,0,8,0"/>

                <!--
                    Live command-name suggestions from the @DS@ commands list.
                    The popup is visual only; Tab/Shift+Tab keep keyboard focus
                    in CommandInput and cycle the same matching command set.
                -->
                <Popup x:Name="CommandSuggestionsPopup"
                       PlacementTarget="{Binding ElementName=CommandInput}"
                       Placement="Top"
                       VerticalOffset="-4"
                       AllowsTransparency="True"
                       StaysOpen="True">
                    <Border x:Name="CommandSuggestionsBorder"
                            MaxHeight="280"
                            Background="{DynamicResource SuggestionBackgroundBrush}"
                            BorderBrush="{DynamicResource SuggestionBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="CommandSuggestionsList"
                                     Grid.Row="0"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{DynamicResource SuggestionBackgroundBrush}"
                                     Foreground="{DynamicResource SuggestionForegroundBrush}"
                                     BorderThickness="0"
                                     MaxHeight="240"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewMouseLeftButtonUp="CommandSuggestionsList_PreviewMouseLeftButtonUp"/>

                            <TextBlock x:Name="CommandSuggestionsStatus"
                                       Grid.Row="1"
                                       Margin="5,4,5,2"
                                       Foreground="{DynamicResource SuggestionMutedBrush}"
                                       FontSize="11"/>
                        </Grid>
                    </Border>
                </Popup>

                <Button Grid.Column="1"
                        Content="Send"
                        Command="{Binding SendCommandCommand}"/>
            </Grid>
        </Grid>

        <!-- FOOTER: human-readable application status / version -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Theme:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <ComboBox x:Name="ThemeComboBox"
                          Width="82"
                          MinHeight="26"
                          Padding="5,1"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ThemeComboBox_SelectionChanged"/>
            </StackPanel>

            <Button x:Name="VersionLinkButton"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    MinHeight="0"
                    Padding="3,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="VersionLink_Click"
                    ToolTip="About BCS Tool"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
