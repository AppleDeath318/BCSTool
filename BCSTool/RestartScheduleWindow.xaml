<Window x:Class="BCSTool.RestartScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restart Settings"
        Width="680"
        Height="360"
        MinWidth="620"
        MinHeight="340"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Server Restart"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <GroupBox Grid.Row="1"
                  Header="Restart Settings">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Restart every (hours):"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          ItemsSource="{Binding RestartHourOptions}"
                          SelectedItem="{Binding RestartEveryHours}"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Setting to 0 disables scheduled restarts."
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,10"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Restart at minute:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          ItemsSource="{Binding MinuteOptions}"
                          SelectedItem="{Binding RestartMinute}"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Countdown warning (minutes):"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          ItemsSource="{Binding WarningMinuteOptions}"
                          SelectedItem="{Binding WarningMinutesBefore}"
                          VerticalContentAlignment="Center"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Changes take effect only after Apply."
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,10,0"/>
            <Button Grid.Column="1"
                    Content="Apply &amp; Close"
                    Margin="6,0,0,0"
                    Click="ApplyAndClose_Click"/>
            <Button Grid.Column="2"
                    Content="Apply"
                    Margin="6,0,0,0"
                    Click="Apply_Click"/>
            <Button Grid.Column="3"
                    Content="Close"
                    Margin="6,0,0,0"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
