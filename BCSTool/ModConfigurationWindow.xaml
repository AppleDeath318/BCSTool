<Window x:Class="BCSTool.ModConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:infra="clr-namespace:BCSTool.Infrastructure"
        Title="Mod Configuration"
        Width="920"
        Height="850"
        MinWidth="820"
        MinHeight="650"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">

    <Window.Resources>
        <infra:BooleanEnabledDisabledConverter x:Key="BooleanEnabledDisabledConverter"/>

        <Style TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <x:Array x:Key="DifficultyLevels" Type="{x:Type sys:String}">
            <sys:String>VeryEasy</sys:String>
            <sys:String>Easy</sys:String>
            <sys:String>Realistic</sys:String>
        </x:Array>

        <x:Array x:Key="EnabledDisabledOptions" Type="{x:Type sys:String}">
            <sys:String>Enabled</sys:String>
            <sys:String>Disabled</sys:String>
        </x:Array>

        <x:Array x:Key="BattleChangeModes" Type="{x:Type sys:String}">
            <sys:String>Enabled</sys:String>
            <sys:String>OneDayMax</sys:String>
            <sys:String>Disabled</sys:String>
        </x:Array>

        <x:Array x:Key="LordDefectionRetryModes" Type="{x:Type sys:String}">
            <sys:String>Vanilla</sys:String>
            <sys:String>NeverExpire</sys:String>
            <sys:String>AlwaysRetry</sys:String>
        </x:Array>
    </Window.Resources>

    <DockPanel Margin="14">

        <Grid DockPanel.Dock="Bottom"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Save &amp; Close"
                    Click="SaveAndClose_Click"
                    Margin="0,0,4,0"/>

            <Button Grid.Column="1"
                    Content="Save"
                    Click="Save_Click"
                    Margin="4,0,4,0"/>

            <Button Grid.Column="2"
                    Content="Close"
                    Click="Close_Click"
                    Margin="4,0,0,0"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Bannerlord Coop Mod Configuration"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Changes are written to mod-config.json. Campaign/mod settings are normally applied during server boot."
                           TextWrapping="Wrap"
                           Margin="0,4,0,10"/>

                <TextBlock x:Name="ConfigPathText"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <GroupBox Header="Campaign Difficulty"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="3"
                                   Text="Bannerlord Coop v0.1.6 applies these values on the hosting side at every boot."
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Player received damage"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding PlayerReceivedDamage}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Player troops received damage"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding PlayerTroopsReceivedDamage}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Combat AI difficulty"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding CombatAIDifficulty}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Recruitment difficulty"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding RecruitmentDifficulty}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Player map movement speed"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="5" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding PlayerMapMovementSpeed}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="Stealth / disguise difficulty"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="6" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding StealthAndDisguiseDifficulty}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="7" Grid.Column="0"
                                   Text="Persuasion success chance"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="7" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding PersuasionSuccessChance}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="8" Grid.Column="0"
                                   Text="Clan member death chance"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="8" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding ClanMemberDeathChance}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="9" Grid.Column="0"
                                   Text="Battle death"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="9" Grid.Column="1"
                                  ItemsSource="{StaticResource DifficultyLevels}"
                                  SelectedItem="{Binding BattleDeath}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="10" Grid.Column="0"
                                   Text="Birth and death"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="10" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding BirthAndDeath, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="10" Grid.Column="2"
                                   Text="Controls aging, births, and natural deaths"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="11" Grid.Column="0"
                                   Text="Auto-allocate clan member perks"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="11" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding AutoAllocateClanMemberPerks, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Proximity Voice"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Voice chat"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding VoiceEnabled, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Enables proximity voice for all players"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Map full-volume distance"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding MapFullVolumeDistance, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding VoiceEnabled}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="Default: 5"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Map maximum distance"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding MapMaximumDistance, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding VoiceEnabled}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="Must be greater than the map full-volume distance; default: 20"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Scene full-volume distance"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding SceneFullVolumeDistance, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding VoiceEnabled}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="2"
                                   Text="Default: 10"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Scene maximum distance"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 Text="{Binding SceneMaximumDistance, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding VoiceEnabled}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2"
                                   Text="Must be greater than the scene full-volume distance; default: 50"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="General"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Battle size"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding BattleSize, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="200–1000 total human troops"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Fast forwarding"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding FastForwardEnabled, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Auto pause"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding AutoPauseEnabled, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Client cheats"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding ClientsCanUseCheats, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Speed limit while players are in battle"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding SpeedLimitWhilePlayersInBattle, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Player nameplates"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="5" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding ShowPlayerNameplates, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="2"
                                   Text="Controls whether clients may show allied player nameplates"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="Allow wounded players to join battles"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="6" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding PlayerWoundedBattleEntry, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Economy"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Gold/food/influence changes in settlements"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding GoldFoodInfluenceChangeInSettlements, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Gold/food/influence changes in battles"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{StaticResource BattleChangeModes}"
                                  SelectedItem="{Binding GoldFoodInfluenceChangeInBattles}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Gold/food/influence changes for disconnected players"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding GoldFoodInfluenceChangeForDisconnectedPlayers, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Other">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="AI battle join window (hours)"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding PlayerBattleAiJoinWindowHours, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="0 prevents AI parties joining player battles"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Wanderer / companion limit"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding WandererLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="Vanilla limit: 32"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Wanderer limit scales with players"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding WandererLimitScalesWithPlayers, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Clan tier required to form kingdom"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding PlayerKingdomClanTierRequired, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="2"
                                   Text="Vanilla tier requirement: 4"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Smithing stamina regeneration out of settlements"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding SmithingStaminaRecoveryOutsideSettlements, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Smithing stamina recovery multiplier"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="5" Grid.Column="1"
                                 Text="{Binding SmithingStaminaRecoveryMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="Looter / bandit party count multiplier"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding MaximumLootersMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="2"
                                   Text="High values may hurt performance"
                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="7" Grid.Column="0"
                                   Text="Looter / bandit party size multiplier"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <TextBox Grid.Row="7" Grid.Column="1"
                                 Text="{Binding LooterPartySizeMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Grid.Column="2"
                                   Text="Applies only to newly created parties"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="8" Grid.Column="0"
                                   Text="Lord defection retries"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="8" Grid.Column="1"
                                  ItemsSource="{StaticResource LordDefectionRetryModes}"
                                  SelectedItem="{Binding LordDefectionRetries}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="8" Grid.Column="2"
                                   Text="Vanilla = refusal expires after one in-game year"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="9" Grid.Column="0"
                                   Text="Allow hero executions"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="9" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding EnableHeroExecutions, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="9" Grid.Column="2"
                                   Text="Master switch for hero executions"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="10" Grid.Column="0"
                                   Text="Allow player clan member executions"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="10" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding EnablePlayerClanMemberExecutions, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  IsEnabled="{Binding EnableHeroExecutions}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="10" Grid.Column="2"
                                   Text="Includes player companions and family; requires hero executions"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="11" Grid.Column="0"
                                   Text="Block AI wars against offline players"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="11" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding BlockAiWarDeclarationsOnOfflinePlayers, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="11" Grid.Column="2"
                                   Text="Refuses new AI war proposals and alliance calls while every affected player is offline"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="12" Grid.Column="0"
                                   Text="Maintain unaffiliated wanderers"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="12" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding EnsureUnaffiliatedWanderers, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="12" Grid.Column="2"
                                   Text="When enabled, the wanderer limit targets recruitable unaffiliated wanderers"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,8"/>

                        <TextBlock Grid.Row="13" Grid.Column="0"
                                   Text="Co-op clans and player marriages"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>
                        <ComboBox Grid.Row="13" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding CoopClansEnabled, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="14" Grid.Column="0"
                                   Text="Allow player executions"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="14" Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding EnablePlayerExecutions, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  IsEnabled="{Binding EnableHeroExecutions}"/>
                        <TextBlock Grid.Row="14" Grid.Column="2"
                                   Text="Allows players to execute each other; requires hero executions"
                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
