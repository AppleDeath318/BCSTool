<Window x:Class="BCSTool.ServerConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:infra="clr-namespace:BCSTool.Infrastructure"
        Title="Server Configuration"
        Width="650"
        Height="650"
        MinWidth="560"
        MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">

    <Window.Resources>
        <infra:BooleanEnabledDisabledConverter x:Key="BooleanEnabledDisabledConverter"/>

        <Style TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <x:Array x:Key="EnabledDisabledOptions" Type="{x:Type sys:String}">
            <sys:String>Enabled</sys:String>
            <sys:String>Disabled</sys:String>
        </x:Array>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Bottom action row: intentionally ordered Save & Close, Save, Close. -->
        <Grid DockPanel.Dock="Bottom"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Save &amp; Close"
                    Click="SaveAndClose_Click"
                    Margin="0,0,4,0"/>

            <Button Grid.Column="1"
                    Content="Save"
                    Click="Save_Click"
                    Margin="4,0,4,0"/>

            <Button Grid.Column="2"
                    Content="Close"
                    Click="Close_Click"
                    Margin="4,0,0,0"/>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Keep section borders visually separate from the scrollbar. -->
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Dedicated Server Configuration"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Settings are written to server-config.json"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10"/>

                <TextBlock x:Name="ConfigPathText"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <GroupBox Header="World / Saving"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Save name:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,8"
                                 ToolTip="Save to host, without the .sav extension."/>

                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Width="130"
                                Content="Open Save Folder"
                                Click="OpenSaveFolder_Click"
                                Margin="0,0,0,8"
                                ToolTip="Open the Bannerlord Coop dedicated server Game Saves folder."/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Autosave interval (minutes):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding AutosaveMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,8"
                                 ToolTip="0 disables autosaving."/>

                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Width="130"
                                Content="Load Backup"
                                Click="LoadBackup_Click"
                                Margin="0,0,0,8"
                                ToolTip="Load one of Bannerlord Coop's native backups from the Game Saves folder. The server must be fully stopped."/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="Load Backup uses Bannerlord Coop's native per-world backups stored beside the active save."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   FontSize="11"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Save Backups"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="SaveBackupsEnabledCheckBox"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3"
                                  Content="Enable BCS Tool save backups"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Backup generations to keep:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>

                        <ComboBox x:Name="SaveBackupCountComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Width="120"
                                  HorizontalAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  IsEnabled="{Binding IsChecked, ElementName=SaveBackupsEnabledCheckBox}"
                                  Margin="0,0,8,8"/>

                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Width="150"
                                Content="Open BCS Backup Folder"
                                Click="OpenBackupFolder_Click"
                                Margin="0,0,0,8"/>

                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource WarningPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8">
                            <TextBlock Text="When disabled, only Bannerlord Coop's native two-generation backup method is used. When enabled, BCS Tool additionally stores configurable .sav/.json backup pairs in the BCS Backups folder."
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Connections"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Server password:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,8"/>

                        <Grid Grid.Row="0"
                              Grid.Column="1"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Margin="0,0,10,0">
                                <PasswordBox x:Name="ServerPasswordBox"
                                             PasswordChar="*"
                                             PasswordChanged="ServerPasswordBox_PasswordChanged"
                                             ToolTip="Up to 128 characters. Empty means no password."/>

                                <TextBox x:Name="VisibleServerPasswordTextBox"
                                         Visibility="Collapsed"
                                         TextChanged="VisibleServerPasswordTextBox_TextChanged"
                                         ToolTip="Up to 128 characters. Empty means no password."/>
                            </Grid>

                            <CheckBox x:Name="ShowPasswordCheckBox"
                                      Grid.Column="1"
                                      Content="Show password"
                                      VerticalAlignment="Center"
                                      Checked="ShowPasswordCheckBox_Changed"
                                      Unchecked="ShowPasswordCheckBox_Changed"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Steam Lobby"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{StaticResource EnabledDisabledOptions}"
                                  SelectedItem="{Binding Steam, Converter={StaticResource BooleanEnabledDisabledConverter}, Mode=TwoWay}"
                                  Width="150"
                                  HorizontalAlignment="Left"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Logging"
                          Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox IsChecked="{Binding LogFile, Mode=OneWay}"
                                  IsEnabled="False"
                                  Content="Write server output to coop-server log files"/>

                        <TextBlock Margin="0,7,0,0"
                                   Text="BCS Tool depends on the coop-server log file for console output and server monitoring, so this option is required and cannot be disabled."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Diagnostics">
                    <StackPanel Margin="10">
                        <TextBlock Text="Normally leave these disabled. Enable only when collecting diagnostic logs."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <CheckBox IsChecked="{Binding TraceTick}"
                                  Content="traceTick"
                                  Margin="0,0,0,5"/>

                        <CheckBox IsChecked="{Binding TracePublish}"
                                  Content="tracePublish"
                                  Margin="0,0,0,5"/>

                        <CheckBox IsChecked="{Binding TraceBandits}"
                                  Content="traceBandits"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
